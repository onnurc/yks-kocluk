### Build output / OS cruft (repo-wide) ###
# frontend/.gitignore covers these under frontend/ only — scripts/node_modules and a
# repo-root .DS_Store fall outside it, so they are caught here for every directory.
node_modules/
.DS_Store

### Node / OS noise (scripts/ has its own package.json — never commit its deps) ###
node_modules/
.DS_Store

### Secrets — never commit real local config (use application-local.yml.example as the template) ###
application-local*.yml
src/main/resources/application-local*.yml
!**/src/main/**/target/
!**/src/test/**/target/

